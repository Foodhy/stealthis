---
import { loadChallenges, loadLessons } from "@schema";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import Chrome from "../../components/Chrome.astro";
import QuizRunner from "../../components/runners/QuizRunner.astro";
import CompleteRunner from "../../components/runners/CompleteRunner.astro";
import FixRunner from "../../components/runners/FixRunner.astro";
import IdentifyRunner from "../../components/runners/IdentifyRunner.astro";
import AnimationRunner from "../../components/runners/AnimationRunner.astro";

export async function getStaticPaths() {
  const contentDir = join(process.cwd(), "..", "..", "packages", "content");
  const [challenges, lessons] = await Promise.all([
    loadChallenges(contentDir),
    loadLessons(contentDir),
  ]);

  return lessons.map((lesson) => {
    const ordered = lesson.challenges
      .map((slug) => challenges.find((c) => c.slug === slug))
      .filter((c): c is NonNullable<typeof c> => Boolean(c));

    return {
      params: { topic: lesson.topic, lesson: lesson.slug },
      props: { lesson, challenges: ordered },
    };
  });
}

const { topic, lesson: lessonSlug } = Astro.params;
const { lesson, challenges } = Astro.props;
---

<Base title={`Arcade · ${lesson.title}`} hideHeader fullBleed>
  <Chrome
    topic={topic!}
    lessonTitle={lesson.title}
    total={challenges.length}
    difficulties={challenges.map((c) => c.difficulty)}
  />

  <div class="mx-auto max-w-3xl px-4 pb-24 sm:px-6" data-runner data-topic={topic} data-lesson={lessonSlug}>
    {challenges.map((c, i) => {
      if (c.type === "quiz") return <QuizRunner challenge={c} index={i} />;
      if (c.type === "complete") return <CompleteRunner challenge={c} index={i} />;
      if (c.type === "fix") return <FixRunner challenge={c} index={i} />;
      if (c.type === "identify") return <IdentifyRunner challenge={c} index={i} />;
      if (c.type === "animation") return <AnimationRunner challenge={c} index={i} />;
      return (
        <article
          class="challenge-slide hidden flex-col gap-4 py-10"
          data-challenge
          data-slug={c.slug}
          data-type={c.type}
          data-index={i}
        >
          <span class="text-xs uppercase tracking-wider text-white/40">{c.topic} · {c.type}</span>
          <h2 class="text-2xl font-medium text-white">{c.title}</h2>
          <p class="text-white/50">This challenge type isn't implemented yet. Skipping.</p>
          <div class="flex justify-end">
            <button
              type="button"
              class="rounded-lg bg-emerald-400 px-5 py-2.5 text-sm font-semibold text-emerald-950 hover:bg-emerald-300"
              data-next
            >
              Skip
            </button>
          </div>
        </article>
      );
    })}

    <section class="result-screen hidden flex-col items-center gap-6 py-16 text-center" data-result-screen>
      <div class="text-5xl">🎉</div>
      <h2 class="text-3xl font-semibold text-white">Lesson complete</h2>
      <p class="text-white/60">
        <span data-result-correct>0</span> / <span data-result-total>{challenges.length}</span> correct
      </p>
      <div class="flex items-center gap-3 pt-4">
        <a
          href={`/${topic}/`}
          class="rounded-lg bg-white/8 px-5 py-2.5 text-sm font-medium text-white hover:bg-white/14"
        >
          Back to {topic}
        </a>
        <button
          type="button"
          class="rounded-lg bg-emerald-400 px-5 py-2.5 text-sm font-semibold text-emerald-950 hover:bg-emerald-300"
          data-retry
        >
          Retry lesson
        </button>
      </div>
    </section>
  </div>
</Base>

<style is:global>
  .challenge-slide {
    display: none;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 180ms ease-out,
      transform 180ms ease-out;
  }
  .challenge-slide[data-active="true"] {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }
  .quiz-option[data-selected="true"] {
    @apply border-white/40 bg-white/14;
  }
  .quiz-option[data-result="correct"] {
    @apply border-emerald-400/70 bg-emerald-400/14 text-white;
  }
  .quiz-option[data-result="incorrect"] {
    @apply border-rose-400/70 bg-rose-400/14 text-white;
  }
</style>

<script>
  import { buildSrcdoc } from "../../lib/sandbox";
  import { domEqual } from "../../lib/dom-compare";

  const runner = document.querySelector<HTMLElement>("[data-runner]");
  if (!runner) throw new Error("runner root missing");

  const slides = Array.from(runner.querySelectorAll<HTMLElement>("[data-challenge]"));
  const resultScreen = runner.querySelector<HTMLElement>("[data-result-screen]");
  const progressText = document.querySelector<HTMLElement>("[data-progress-text]");
  const progressBar = document.querySelector<HTMLElement>("[data-progress-bar]");
  const total = slides.length;

  let stepIndex = 0;
  let correctCount = 0;

  type ProgressEntry = { correct: boolean; completedAt: number };
  type Progress = Record<string, ProgressEntry>;

  function readProgress(): Progress {
    try {
      return JSON.parse(localStorage.getItem("arcade:progress") || "{}");
    } catch {
      return {};
    }
  }

  function writeProgress(slug: string, correct: boolean) {
    const p = readProgress();
    p[slug] = { correct, completedAt: Date.now() };
    localStorage.setItem("arcade:progress", JSON.stringify(p));
  }

  const difficulties: number[] = JSON.parse(progressText?.dataset.difficulties || "[]");
  const pips = Array.from(document.querySelectorAll<HTMLElement>("[data-pip]"));

  function setStep(i: number) {
    slides.forEach((s, idx) => {
      s.dataset.active = idx === i ? "true" : "false";
    });
    if (progressText) {
      progressText.textContent = `${Math.min(i + 1, total)} / ${total}`;
    }
    if (progressBar) {
      progressBar.style.width = `${((i + 1) / total) * 100}%`;
    }
    const diff = difficulties[i] ?? 1;
    pips.forEach((pip, idx) => {
      const filled = idx < diff;
      pip.classList.toggle("bg-emerald-400", filled);
      pip.classList.toggle("bg-white/14", !filled);
    });
    // Focus the first interactive element on the new slide so keyboard nav feels natural.
    const active = slides[i];
    if (active) {
      const focusable = active.querySelector<HTMLElement>(
        "input, button[data-check], .quiz-option"
      );
      focusable?.focus({ preventScroll: true });
    }
  }

  function showResult() {
    slides.forEach((s) => (s.dataset.active = "false"));
    if (resultScreen) {
      resultScreen.classList.remove("hidden");
      resultScreen.classList.add("flex");
      const correctEl = resultScreen.querySelector("[data-result-correct]");
      if (correctEl) correctEl.textContent = String(correctCount);
    }
    if (progressBar) progressBar.style.width = "100%";
    if (progressText) progressText.textContent = `${total} / ${total}`;
  }

  function advance(wasCorrect: boolean) {
    if (wasCorrect) correctCount += 1;
    stepIndex += 1;
    if (stepIndex >= total) {
      showResult();
    } else {
      setStep(stepIndex);
    }
  }

  function getActiveSlide(): HTMLElement | null {
    return slides.find((s) => s.dataset.active === "true") ?? null;
  }

  // Per-slide wiring.
  slides.forEach((slide) => {
    const type = slide.dataset.type;
    const slug = slide.dataset.slug!;

    if (type === "quiz") wireQuiz(slide, slug);
    else if (type === "complete") wireComplete(slide, slug);
    else if (type === "fix") wireFix(slide, slug);
    else if (type === "identify") wireIdentify(slide, slug);
    else if (type === "animation") wireAnimation(slide, slug);
    else wireUnimplemented(slide, slug);
  });

  function wireQuiz(slide: HTMLElement, slug: string) {
    const answer = Number(slide.dataset.answer);
    const options = Array.from(slide.querySelectorAll<HTMLButtonElement>(".quiz-option"));
    const checkBtn = slide.querySelector<HTMLButtonElement>("[data-check]")!;
    const nextBtn = slide.querySelector<HTMLButtonElement>("[data-next]")!;
    const explanation = slide.querySelector<HTMLElement>("[data-explanation]");
    let picked: number | null = null;

    options.forEach((opt) => {
      opt.addEventListener("click", () => {
        if (slide.dataset.checked === "true") return;
        picked = Number(opt.dataset.optionIndex);
        options.forEach((o) => {
          o.dataset.selected = o === opt ? "true" : "false";
        });
        checkBtn.disabled = false;
      });
    });

    checkBtn.addEventListener("click", () => {
      if (picked == null || slide.dataset.checked === "true") return;
      slide.dataset.checked = "true";
      options.forEach((o, i) => {
        o.disabled = true;
        if (i === answer) o.dataset.result = "correct";
        else if (i === picked) o.dataset.result = "incorrect";
      });
      if (explanation) explanation.classList.remove("hidden");
      checkBtn.classList.add("hidden");
      nextBtn.classList.remove("hidden");
      const wasCorrect = picked === answer;
      writeProgress(slug, wasCorrect);
      nextBtn.dataset.wasCorrect = String(wasCorrect);
      nextBtn.focus();
    });

    nextBtn.addEventListener("click", () => {
      advance(nextBtn.dataset.wasCorrect === "true");
    });
  }

  function wireComplete(slide: HTMLElement, slug: string) {
    const answers: Record<string, string> = JSON.parse(slide.dataset.answers || "{}");
    const caseSensitive = slide.dataset.caseSensitive === "true";
    const inputs = Array.from(slide.querySelectorAll<HTMLInputElement>(".complete-blank"));
    const checkBtn = slide.querySelector<HTMLButtonElement>("[data-check]")!;
    const nextBtn = slide.querySelector<HTMLButtonElement>("[data-next]")!;
    const explanation = slide.querySelector<HTMLElement>("[data-explanation]");

    function syncCheckable() {
      const allFilled = inputs.every((i) => i.value.trim().length > 0);
      checkBtn.disabled = !allFilled;
    }

    inputs.forEach((input) => {
      input.addEventListener("input", syncCheckable);
    });

    checkBtn.addEventListener("click", () => {
      if (slide.dataset.checked === "true") return;
      slide.dataset.checked = "true";
      let allCorrect = true;
      inputs.forEach((input) => {
        const key = input.dataset.blankKey!;
        const expected = answers[key] ?? "";
        const actual = input.value.trim();
        const matches = caseSensitive
          ? actual === expected
          : actual.toLowerCase() === expected.toLowerCase();
        input.dataset.result = matches ? "correct" : "incorrect";
        input.disabled = true;
        if (!matches) allCorrect = false;
      });
      if (explanation) explanation.classList.remove("hidden");
      checkBtn.classList.add("hidden");
      nextBtn.classList.remove("hidden");
      writeProgress(slug, allCorrect);
      nextBtn.dataset.wasCorrect = String(allCorrect);
      nextBtn.focus();
    });

    nextBtn.addEventListener("click", () => {
      advance(nextBtn.dataset.wasCorrect === "true");
    });
  }

  function wireFix(slide: HTMLElement, slug: string) {
    const editor = slide.querySelector<HTMLTextAreaElement>("[data-editor]")!;
    const preview = slide.querySelector<HTMLIFrameElement>("[data-preview]")!;
    const solution = slide.querySelector<HTMLIFrameElement>("[data-solution]")!;
    const checkBtn = slide.querySelector<HTMLButtonElement>("[data-check]")!;
    const nextBtn = slide.querySelector<HTMLButtonElement>("[data-next]")!;
    const status = slide.querySelector<HTMLElement>("[data-status]")!;
    const explanation = slide.querySelector<HTMLElement>("[data-explanation]");
    const lineNumbers = slide.querySelector<HTMLElement>("[data-line-numbers]");
    const criterion = (slide.dataset.criterion || "dom-equal") as "dom-equal" | "regex" | "visual";
    const regexPattern = slide.dataset.regex || "";
    const solutionSource = solution.dataset.solutionSource ?? "";

    function updateLineNumbers() {
      if (!lineNumbers) return;
      const count = editor.value.split("\n").length;
      const out: string[] = [];
      for (let i = 1; i <= count; i++) out.push(String(i));
      lineNumbers.textContent = out.join("\n");
    }

    function syncScroll() {
      if (!lineNumbers) return;
      lineNumbers.scrollTop = editor.scrollTop;
    }

    function updatePreview() {
      preview.srcdoc = buildSrcdoc(editor.value);
    }

    function waitForLoad(frame: HTMLIFrameElement): Promise<void> {
      // If document is already complete (cached or pre-loaded), resolve immediately.
      if (frame.contentDocument?.readyState === "complete") return Promise.resolve();
      return new Promise((resolve) => {
        const onLoad = () => {
          frame.removeEventListener("load", onLoad);
          resolve();
        };
        frame.addEventListener("load", onLoad, { once: true });
      });
    }

    async function compareNow(): Promise<boolean> {
      if (criterion === "regex") {
        if (!regexPattern) return false;
        try {
          return new RegExp(regexPattern).test(editor.value);
        } catch {
          return false;
        }
      }
      // dom-equal (visual falls back to dom-equal for v1)
      // Re-set srcdoc to guarantee both frames reflect the latest source, then await load.
      preview.srcdoc = buildSrcdoc(editor.value);
      solution.srcdoc = buildSrcdoc(solutionSource);
      await Promise.all([waitForLoad(preview), waitForLoad(solution)]);
      const userDoc = preview.contentDocument;
      const solDoc = solution.contentDocument;
      if (!userDoc || !solDoc) return false;
      return domEqual(userDoc, solDoc);
    }

    editor.addEventListener("input", () => {
      updatePreview();
      updateLineNumbers();
    });
    editor.addEventListener("scroll", syncScroll);

    // Prime both iframes once they're attached.
    solution.srcdoc = buildSrcdoc(solutionSource);
    updatePreview();
    updateLineNumbers();

    checkBtn.addEventListener("click", async () => {
      if (slide.dataset.checked === "true") return;
      slide.dataset.checked = "true";
      status.textContent = "Checking…";
      const ok = await compareNow();
      status.textContent = ok ? "Looks right." : "Not quite — keep tweaking.";
      status.classList.toggle("text-emerald-400", ok);
      status.classList.toggle("text-rose-400", !ok);
      editor.disabled = true;
      if (explanation) explanation.classList.remove("hidden");
      checkBtn.classList.add("hidden");
      nextBtn.classList.remove("hidden");
      writeProgress(slug, ok);
      nextBtn.dataset.wasCorrect = String(ok);
      nextBtn.focus();
    });

    nextBtn.addEventListener("click", () => {
      advance(nextBtn.dataset.wasCorrect === "true");
    });
  }

  function wireIdentify(slide: HTMLElement, slug: string) {
    const mode = slide.dataset.mode; // "line" | "mcq"
    const answerRaw = slide.dataset.answer ?? "";
    const checkBtn = slide.querySelector<HTMLButtonElement>("[data-check]")!;
    const nextBtn = slide.querySelector<HTMLButtonElement>("[data-next]")!;
    const explanation = slide.querySelector<HTMLElement>("[data-explanation]");
    let picked: number | null = null;

    if (mode === "line") {
      const lines = Array.from(slide.querySelectorAll<HTMLButtonElement>(".identify-line-btn"));
      lines.forEach((line) => {
        line.addEventListener("click", () => {
          if (slide.dataset.checked === "true") return;
          picked = Number(line.dataset.lineIndex);
          lines.forEach((l) => {
            l.dataset.selected = l === line ? "true" : "false";
          });
          checkBtn.disabled = false;
        });
      });
    } else {
      const opts = Array.from(slide.querySelectorAll<HTMLButtonElement>(".quiz-option"));
      opts.forEach((opt) => {
        opt.addEventListener("click", () => {
          if (slide.dataset.checked === "true") return;
          picked = Number(opt.dataset.optionIndex);
          opts.forEach((o) => {
            o.dataset.selected = o === opt ? "true" : "false";
          });
          checkBtn.disabled = false;
        });
      });
    }

    checkBtn.addEventListener("click", () => {
      if (picked == null || slide.dataset.checked === "true") return;
      slide.dataset.checked = "true";
      const expected = Number(answerRaw);
      const wasCorrect = picked === expected;

      if (mode === "line") {
        const lines = Array.from(slide.querySelectorAll<HTMLButtonElement>(".identify-line-btn"));
        lines.forEach((line, i) => {
          line.disabled = true;
          if (i === expected) line.dataset.result = "correct";
          else if (i === picked) line.dataset.result = "incorrect";
        });
      } else {
        const opts = Array.from(slide.querySelectorAll<HTMLButtonElement>(".quiz-option"));
        opts.forEach((o, i) => {
          o.disabled = true;
          if (i === expected) o.dataset.result = "correct";
          else if (i === picked) o.dataset.result = "incorrect";
        });
      }
      if (explanation) explanation.classList.remove("hidden");
      checkBtn.classList.add("hidden");
      nextBtn.classList.remove("hidden");
      writeProgress(slug, wasCorrect);
      nextBtn.dataset.wasCorrect = String(wasCorrect);
      nextBtn.focus();
    });

    nextBtn.addEventListener("click", () => {
      advance(nextBtn.dataset.wasCorrect === "true");
    });
  }

  function wireAnimation(slide: HTMLElement, slug: string) {
    const hasFollowUp = slide.dataset.hasFollowup === "true";
    const checkBtn = slide.querySelector<HTMLButtonElement>("[data-check]")!;
    const nextBtn = slide.querySelector<HTMLButtonElement>("[data-next]")!;
    const explanation = slide.querySelector<HTMLElement>("[data-explanation]");

    if (hasFollowUp) {
      const answer = Number(slide.dataset.answer);
      const opts = Array.from(slide.querySelectorAll<HTMLButtonElement>(".quiz-option"));
      let picked: number | null = null;

      opts.forEach((opt) => {
        opt.addEventListener("click", () => {
          if (slide.dataset.checked === "true") return;
          picked = Number(opt.dataset.optionIndex);
          opts.forEach((o) => {
            o.dataset.selected = o === opt ? "true" : "false";
          });
          checkBtn.disabled = false;
        });
      });

      checkBtn.addEventListener("click", () => {
        if (picked == null || slide.dataset.checked === "true") return;
        slide.dataset.checked = "true";
        opts.forEach((o, i) => {
          o.disabled = true;
          if (i === answer) o.dataset.result = "correct";
          else if (i === picked) o.dataset.result = "incorrect";
        });
        const wasCorrect = picked === answer;
        if (explanation) explanation.classList.remove("hidden");
        checkBtn.classList.add("hidden");
        nextBtn.classList.remove("hidden");
        writeProgress(slug, wasCorrect);
        nextBtn.dataset.wasCorrect = String(wasCorrect);
        nextBtn.focus();
      });
    } else {
      const reflectionInput = slide.querySelector<HTMLInputElement>("[data-animation-reflection]");
      const minChars = 12;

      const syncCheckable = () => {
        const text = reflectionInput?.value.trim() ?? "";
        checkBtn.disabled = text.length < minChars;
      };

      reflectionInput?.addEventListener("input", syncCheckable);
      syncCheckable();

      checkBtn.addEventListener("click", () => {
        if (slide.dataset.checked === "true" || !reflectionInput) return;
        if (reflectionInput.value.trim().length < minChars) return;
        slide.dataset.checked = "true";
        reflectionInput.disabled = true;
        if (explanation) explanation.classList.remove("hidden");
        checkBtn.classList.add("hidden");
        nextBtn.classList.remove("hidden");
        writeProgress(slug, true);
        nextBtn.dataset.wasCorrect = "true";
        nextBtn.focus();
      });
    }

    nextBtn.addEventListener("click", () => {
      advance(nextBtn.dataset.wasCorrect === "true");
    });
  }

  function wireUnimplemented(slide: HTMLElement, slug: string) {
    const nextBtn = slide.querySelector<HTMLButtonElement>("[data-next]");
    nextBtn?.addEventListener("click", () => {
      writeProgress(slug, false);
      advance(false);
    });
  }

  // Global keyboard nav.
  document.addEventListener("keydown", (e) => {
    const active = getActiveSlide();
    if (!active) return;

    // Don't hijack typing inside <input> except for Enter/Escape.
    const target = e.target as HTMLElement | null;
    const inField = target?.tagName === "INPUT" || target?.tagName === "TEXTAREA";

    if (e.key === "Enter") {
      // In a textarea, plain Enter must keep producing newlines.
      // Submit only on Cmd/Ctrl+Enter.
      if (target?.tagName === "TEXTAREA" && !(e.metaKey || e.ctrlKey)) return;
      e.preventDefault();
      const nextBtn = active.querySelector<HTMLButtonElement>("[data-next]:not(.hidden)");
      if (nextBtn) {
        nextBtn.click();
        return;
      }
      const checkBtn = active.querySelector<HTMLButtonElement>("[data-check]:not(.hidden)");
      if (checkBtn && !checkBtn.disabled) {
        checkBtn.click();
      }
      return;
    }

    if (e.key === "Escape") {
      e.preventDefault();
      const slug = active.dataset.slug!;
      writeProgress(slug, false);
      advance(false);
      return;
    }

    if (inField) return; // 1..4 hotkeys only outside input fields

    if (active.dataset.type === "quiz" && /^[1-9]$/.test(e.key)) {
      const idx = Number(e.key) - 1;
      const opt = active.querySelector<HTMLButtonElement>(
        `.quiz-option[data-option-index="${idx}"]`
      );
      opt?.click();
    }
  });

  const retry = runner.querySelector<HTMLButtonElement>("[data-retry]");
  retry?.addEventListener("click", () => {
    window.location.reload();
  });

  setStep(0);
</script>
