---
import { join } from "node:path";
import { loadChallenges, loadLessons } from "@schema";
import TopicIcon from "../../components/TopicIcon.astro";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const contentDir = join(process.cwd(), "..", "..", "packages", "content");
  const [challenges, lessons] = await Promise.all([
    loadChallenges(contentDir),
    loadLessons(contentDir),
  ]);

  const topics = new Set<string>();
  for (const c of challenges) topics.add(c.topic);
  for (const l of lessons) topics.add(l.topic);

  return [...topics].map((topic) => ({
    params: { topic },
    props: {
      lessons: lessons.filter((l) => l.topic === topic),
      challengeCount: challenges.filter((c) => c.topic === topic && c.quality === "published")
        .length,
    },
  }));
}

const { topic } = Astro.params;
const { lessons, challengeCount } = Astro.props;
---

<Base title={`Arcade · ${topic}`}>
  <a href="/" class="text-sm text-white/50 hover:text-white">← Topics</a>

  <section class="mt-4 flex items-center gap-4">
    <span class="grid h-12 w-12 place-items-center rounded-xl border border-white/8 bg-white/6 text-white/70">
      <TopicIcon topic={topic!} size={26} />
    </span>
    <div>
      <h1 class="text-3xl font-semibold tracking-tight text-white">{topic}</h1>
      <p class="text-white/60">{challengeCount} published challenge{challengeCount === 1 ? "" : "s"}.</p>
    </div>
  </section>

  <section class="mt-10">
    {lessons.length === 0 ? (
      <p class="text-white/50">No lessons yet for this topic.</p>
    ) : (
      <ul class="space-y-3">
        {lessons.map((l) => (
          <li>
            <a
              href={`/${topic}/${l.slug}`}
              class="block rounded-xl border border-white/8 bg-white/6 p-5 transition hover:border-white/14 hover:bg-white/8"
              data-lesson-card
              data-slugs={JSON.stringify(l.challenges)}
            >
              <div class="flex items-center justify-between">
                <h2 class="text-lg font-medium text-white">{l.title}</h2>
                <span class="text-sm text-white/40" data-lesson-progress>{l.challenges.length} challenge{l.challenges.length === 1 ? "" : "s"}</span>
              </div>
              {l.description && <p class="mt-1 text-sm text-white/50">{l.description}</p>}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<script>
  type ProgressEntry = { correct: boolean; completedAt: number };
  let progress: Record<string, ProgressEntry> = {};
  try {
    progress = JSON.parse(localStorage.getItem("arcade:progress") || "{}");
  } catch {
    progress = {};
  }

  document.querySelectorAll<HTMLElement>("[data-lesson-card]").forEach((card) => {
    const slugsAttr = card.dataset.slugs;
    if (!slugsAttr) return;
    const slugs: string[] = JSON.parse(slugsAttr);
    const total = slugs.length;
    const correct = slugs.filter((s) => progress[s]?.correct).length;
    const label = card.querySelector<HTMLElement>("[data-lesson-progress]");
    if (!label) return;
    label.textContent =
      correct === 0
        ? `${total} challenge${total === 1 ? "" : "s"}`
        : `${correct}/${total} correct`;
  });
</script>
