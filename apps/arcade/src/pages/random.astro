---
import { getPublishedChallenges } from "../lib/code-tabs";

const challenges = await getPublishedChallenges();
const pick = challenges[Math.floor(Math.random() * challenges.length)];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=/c/${pick.slug}`} />
    <title>Random challenge — Arcade</title>
  </head>
  <body>
    <p>Loading random challenge… <a href={`/c/${pick.slug}`}>Continue</a></p>
  </body>
</html>
