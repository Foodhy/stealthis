---
import ProfileBar from "../components/ProfileBar.astro";
import MascotDialogue from "../components/mascot/MascotDialogue.astro";
import LearningPathCard from "../components/LearningPathCard.astro";
import ContinueCard from "../components/ContinueCard.astro";
import Base from "../layouts/Base.astro";
import { loadArcadeData } from "../lib/content";
import { enrichPaths, loadArcadePaths } from "../lib/paths-content";

const paths = await loadArcadePaths();
const { lessons } = await loadArcadeData();
const enriched = enrichPaths(paths, lessons, {});
const sorted = [...enriched].sort((a, b) => a.order - b.order);
const firstPath = sorted[0];
---

<Base title="Arcade — Learn by fixing">
  <div id="arcade-home-data" hidden data-paths={JSON.stringify(sorted)} data-lessons={JSON.stringify(lessons)}></div>

  <ProfileBar sticky />

  <section class="mb-8" data-home-mascot-wrap>
    <MascotDialogue
      message={firstPath?.mascotIntro ?? "Pick a learning path and fix real bugs — one challenge at a time."}
      mood="idle"
    />
  </section>

  <section class="mb-10 hidden" data-continue-section>
    <ContinueCard title="Continue learning" subtitle="Pick up where you left off" href="#" label="Continue" />
  </section>

  <section class="space-y-4">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-white">Learning paths</h1>
        <p class="text-sm text-white/55">Curated roadmaps — unlock units as you progress.</p>
      </div>
      <a
        href="/explore"
        class="rounded-lg border border-white/8 bg-white/6 px-4 py-2 text-sm font-medium text-white/80 transition hover:border-white/14 hover:bg-white/8"
      >
        Explore all topics →
      </a>
    </div>

    <ul class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
      {sorted.map((p) => (
        <li>
          <LearningPathCard path={p} />
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-12 rounded-2xl border border-white/8 bg-white/4 p-6 text-center">
    <p class="text-sm text-white/50">Want something specific?</p>
    <a href="/random" class="mt-3 inline-block text-sm font-medium text-emerald-400 hover:text-emerald-300">
      Try a random challenge
    </a>
  </section>
</Base>

<script>
  import { readProgress, readSession } from "../lib/progress";
  import { readProfile } from "../lib/profile";
  import { buildPathNodes, enrichPaths } from "../lib/paths-unlock";
  import { lessonPath } from "../lib/paths";

  const dataEl = document.getElementById("arcade-home-data");
  const paths = JSON.parse(dataEl?.dataset.paths || "[]");
  const lessons = JSON.parse(dataEl?.dataset.lessons || "[]");

  function hydrateHome() {
    const progress = readProgress();
    const session = readSession();
    const profile = readProfile();
    const enriched = enrichPaths(paths, lessons, progress);

    document.querySelectorAll<HTMLElement>("[data-path-card]").forEach((card) => {
      const slug = card.dataset.pathCard;
      const p = enriched.find((x: { slug: string }) => x.slug === slug);
      if (!p) return;
      card.dataset.progress = String(p.progressPct);
      const pctEl = card.querySelector(".tabular-nums");
      if (pctEl) pctEl.textContent = `${p.progressPct}%`;
      const ring = card.querySelector("circle.text-emerald-400");
      if (ring instanceof SVGCircleElement) ring.setAttribute("stroke-dasharray", `${p.progressPct} 100`);
    });

    const mascot = document.querySelector("[data-home-mascot-wrap] p");
    if (mascot) {
      const streak = profile.streak.current;
      const active = enriched.find((p: { progressPct: number }) => p.progressPct > 0 && p.progressPct < 100);
      if (streak >= 3) {
        mascot.textContent = `${streak}-day streak! ${active ? `Let's keep going with ${active.title}.` : "You're on fire — pick a path."}`;
      } else if (active) {
        mascot.textContent = active.mascotIntro;
      }
    }

    let continueHref: string | null = null;
    let title = "Continue learning";
    let subtitle = "Pick up where you left off";

    for (const [topic, entry] of Object.entries(session)) {
      if (entry && typeof entry === "object" && "lesson" in entry) {
        const e = entry as { lesson: string; stepIndex: number };
        continueHref = lessonPath(topic, e.lesson, e.stepIndex);
        title = topic;
        subtitle = `${e.lesson} · step ${e.stepIndex + 1}`;
        break;
      }
    }

    if (!continueHref) {
      for (const p of enriched) {
        const nodes = buildPathNodes(p, lessons, progress);
        const next = nodes.find((n) => n.state === "in_progress" || n.state === "available");
        if (next && next.state !== "locked") {
          continueHref = next.href;
          title = p.title;
          subtitle = next.lessonTitle;
          break;
        }
      }
    }

    const section = document.querySelector<HTMLElement>("[data-continue-section]");
    const card = document.querySelector<HTMLAnchorElement>("[data-continue-card]");
    if (continueHref && section && card) {
      section.classList.remove("hidden");
      card.href = continueHref;
      const titleEl = card.querySelector("h2");
      const subEl = card.querySelector("p.truncate.text-sm");
      if (titleEl) titleEl.textContent = title;
      if (subEl) subEl.textContent = subtitle;
    }
  }

  hydrateHome();
  document.addEventListener("arcade:profile-updated", hydrateHome);
</script>
