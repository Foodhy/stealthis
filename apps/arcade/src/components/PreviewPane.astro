---
import { IFRAME_SANDBOX } from "../lib/sandbox";

interface Props {
  id: string;
  srcdoc?: string;
  title?: string;
}

const { id, srcdoc = "", title = "Live preview" } = Astro.props;
---

<iframe
  id={id}
  class="preview-pane h-[55vh] min-h-[16rem] w-full flex-1 rounded-xl border border-white/8 bg-white"
  sandbox={IFRAME_SANDBOX}
  srcdoc={srcdoc}
  title={title}
  data-preview-iframe
></iframe>
