---
import type { FixChallenge } from "@schema";
import type { CodeTab } from "../../lib/code-tabs";
import { IFRAME_SANDBOX } from "../../lib/sandbox";
import ChallengeShell from "../ChallengeShell.astro";
import CodePanel from "../CodePanel.astro";
import TweakPanel from "../TweakPanel.astro";

interface Props {
  challenge: FixChallenge;
  index: number;
  codeTabs?: CodeTab[];
  isGenerated?: boolean;
}

const { challenge, index, codeTabs = [], isGenerated = false } = Astro.props;
const panelId = `code-${challenge.slug}`;
const hintsJson = JSON.stringify(challenge.hints ?? []);
---

<article
  class="challenge-slide hidden flex-col gap-6 py-10"
  data-challenge
  data-slug={challenge.slug}
  data-type="fix"
  data-index={index}
  data-difficulty={challenge.difficulty}
  data-criterion={challenge.criterion}
  data-regex={challenge.regexPattern ?? ""}
  data-hints={hintsJson}
  data-generated={String(isGenerated)}
>
  <div class="space-y-2">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs uppercase tracking-wider text-white/40">{challenge.topic}</span>
      {isGenerated && (
        <span class="rounded-full border border-white/10 bg-white/6 px-2 py-0.5 text-[10px] uppercase tracking-wider text-white/45">
          Auto-generated
        </span>
      )}
    </div>
    <h2 class="text-2xl font-medium leading-snug text-white">{challenge.title}</h2>
    {challenge.realWorldHook && (
      <p class="text-sm italic text-white/50">{challenge.realWorldHook}</p>
    )}
  </div>

  <ChallengeShell previewId={`preview-${challenge.slug}`} showPreview={true} interactionLabel="Your fix">
    <iframe
      slot="preview"
      class="preview-pane h-[55vh] min-h-[16rem] w-full rounded-xl border border-white/8 bg-white"
      sandbox={IFRAME_SANDBOX}
      srcdoc=""
      data-preview
      title="What users see"
    ></iframe>

    <div class="space-y-3">
      <div
        class="fix-editor-shell relative flex min-h-[16rem] overflow-hidden rounded-xl border border-white/8 bg-[#070707] font-mono text-sm leading-relaxed text-white focus-within:border-emerald-400"
        data-editor-shell
      >
        <pre
          class="select-none whitespace-pre overflow-hidden border-r border-white/8 py-3 pl-3 pr-2 text-right text-white/30"
          aria-hidden="true"
          data-line-numbers
        ></pre>
        <textarea
          class="fix-editor max-h-[55vh] min-h-[16rem] flex-1 resize-y bg-transparent py-3 pl-3 pr-3 outline-none"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          wrap="off"
          data-editor
        >{challenge.starter}</textarea>
      </div>
      <TweakPanel hints={challenge.hints} panelId={`tweak-${challenge.slug}`} />
    </div>
  </ChallengeShell>

  <iframe
    class="hidden"
    sandbox={IFRAME_SANDBOX}
    srcdoc=""
    data-solution
    data-solution-source={challenge.solution}
    title="Expected output"
    aria-hidden="true"
  ></iframe>

  {challenge.explanation && (
    <div
      class="hidden rounded-xl border border-white/8 bg-white/6 p-4 text-sm leading-relaxed text-white/70"
      data-explanation
    >
      {challenge.explanation}
    </div>
  )}

  {codeTabs.length > 0 && (
    <CodePanel tabs={codeTabs} panelId={panelId} collapsed={true} />
  )}

  {challenge.resourceSlug && (
    <p class="hidden text-sm text-white/50" data-resource-link>
      <a
        href={`https://stealthis.dev/r/${challenge.resourceSlug}`}
        class="text-emerald-400 hover:text-emerald-300"
        target="_blank"
        rel="noopener noreferrer"
      >
        View full example in Library →
      </a>
    </p>
  )}

  <div class="sticky bottom-0 z-20 -mx-1 flex items-center justify-between gap-3 border-t border-white/8 bg-[#0a0a0a]/90 px-1 py-3 backdrop-blur">
    <p class="text-xs text-white/40" data-status>Edit your code or use hint chips. Preview updates live.</p>
    <div class="flex items-center gap-3">
      <button
        type="button"
        class="rounded-lg bg-white/8 px-5 py-2.5 text-sm font-medium text-white/80 transition hover:bg-white/14 disabled:cursor-not-allowed disabled:opacity-40"
        data-check
      >
        Check
      </button>
      <button
        type="button"
        class="hidden rounded-lg bg-emerald-400 px-5 py-2.5 text-sm font-semibold text-emerald-950 transition hover:bg-emerald-300"
        data-next
      >
        Next
      </button>
    </div>
  </div>
</article>
