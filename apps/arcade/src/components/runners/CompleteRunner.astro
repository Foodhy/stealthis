---
import type { CompleteChallenge } from "@schema";
import type { CodeTab } from "../../lib/code-tabs";
import { hintForMode, resolveAllBlanks, usesWordBank } from "../../lib/blank-interaction";
import {
  buildBrokenPreviewSrcdoc,
  buildCompletePreviewSrcdoc,
  loadResourceHtml,
} from "../../lib/complete-preview";
import { renderSegmentedTemplate } from "../../lib/highlight";
import BlankSlot from "../blanks/BlankSlot.astro";
import WordBank from "../blanks/WordBank.astro";
import ChallengeShell from "../ChallengeShell.astro";
import CodePanel from "../CodePanel.astro";
import PreviewPane from "../PreviewPane.astro";

interface Props {
  challenge: CompleteChallenge;
  index: number;
  codeTabs?: CodeTab[];
  isGenerated?: boolean;
}

const { challenge, index, codeTabs = [], isGenerated = false } = Astro.props;

const resolvedBlanks = resolveAllBlanks(challenge);
const { segments, lang } = await renderSegmentedTemplate(challenge.template);
const resourceHtml = challenge.resourceSlug ? loadResourceHtml(challenge.resourceSlug) : null;
const showPreview = Boolean(resourceHtml);
const previewBody = resourceHtml?.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? "";
const previewId = `preview-${challenge.slug}`;
const brokenSrcdoc = showPreview ? buildBrokenPreviewSrcdoc(challenge, resourceHtml) : "";
const initialSrcdoc = brokenSrcdoc ?? "";
const hint = hintForMode(resolvedBlanks[0]?.mode ?? "type");
const answersJson = JSON.stringify(challenge.answers);
const blanksJson = JSON.stringify(resolvedBlanks);
---

<article
  class="challenge-slide hidden flex-col gap-6 py-10"
  data-challenge
  data-slug={challenge.slug}
  data-type="complete"
  data-answers={answersJson}
  data-case-sensitive={String(challenge.caseSensitive)}
  data-index={index}
  data-difficulty={challenge.difficulty}
  data-resource-slug={challenge.resourceSlug ?? ""}
  data-blanks-config={blanksJson}
  data-template={challenge.template}
  data-preview-body={previewBody}
>
  <div class="space-y-2">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs uppercase tracking-wider text-white/40">{challenge.topic}</span>
      {isGenerated && (
        <span class="rounded-full border border-white/10 bg-white/6 px-2 py-0.5 text-[10px] uppercase tracking-wider text-white/45">
          Auto-generated
        </span>
      )}
    </div>
    <h2 class="text-2xl font-medium leading-snug text-white">{challenge.title}</h2>
    {challenge.realWorldHook && (
      <p class="text-sm italic text-white/50">{challenge.realWorldHook}</p>
    )}
  </div>

  <ChallengeShell previewId={previewId} showPreview={showPreview} showPreviewToggle={showPreview}>
    {showPreview && (
      <PreviewPane slot="preview" id={previewId} srcdoc={initialSrcdoc} title={`Preview: ${challenge.title}`} />
    )}

    <div class="space-y-3">
      <div class="arcade-code-block complete-code overflow-x-auto rounded-xl border border-white/10 bg-[#0d1117] shadow-inner shadow-black/40">
        <div class="flex items-center justify-between border-b border-white/8 px-4 py-2">
          <span class="text-[10px] font-semibold uppercase tracking-widest text-emerald-400/80">{lang}</span>
          <span class="text-[10px] text-white/35">{hint}</span>
        </div>
        <div class="shiki shiki-complete m-0 max-h-[55vh] overflow-y-auto overflow-x-auto whitespace-pre-wrap p-4 font-mono text-[13px] leading-6">
          {segments.map((seg) => {
            if (seg.type === "code") {
              return <span class="inline" set:html={seg.html} />;
            }
            const blank = resolvedBlanks.find((b) => b.key === seg.key);
            if (!blank) return null;
            return <BlankSlot blank={blank} />;
          })}
        </div>
      </div>

      {usesWordBank(resolvedBlanks) && <WordBank blanks={resolvedBlanks} />}
    </div>
  </ChallengeShell>

  {challenge.explanation && (
    <div
      class="hidden rounded-xl border border-white/8 bg-white/6 p-4 text-sm leading-relaxed text-white/70"
      data-explanation
    >
      {challenge.explanation}
    </div>
  )}

  {codeTabs.length > 0 && (
    <CodePanel tabs={codeTabs} panelId={`code-${challenge.slug}`} collapsed={true} lang={lang} />
  )}

  <div class="sticky bottom-0 z-20 -mx-1 flex items-center justify-end gap-3 border-t border-white/8 bg-[#0a0a0a]/90 px-1 py-3 backdrop-blur">
    <button
      type="button"
      class="rounded-lg bg-white/8 px-5 py-2.5 text-sm font-medium text-white/80 transition hover:bg-white/14 disabled:cursor-not-allowed disabled:opacity-40"
      data-check
      disabled
    >
      Check
    </button>
    <button
      type="button"
      class="hidden rounded-lg bg-emerald-400 px-5 py-2.5 text-sm font-semibold text-emerald-950 transition hover:bg-emerald-300"
      data-next
    >
      Next
    </button>
  </div>
</article>

<style>
  .shiki-complete :global(.blank-slot[data-result="correct"]),
  .shiki-complete :global(.complete-blank[data-result="correct"]) {
    @apply border-emerald-400 bg-emerald-400/20 text-white;
  }
  .shiki-complete :global(.blank-slot[data-result="incorrect"]),
  .shiki-complete :global(.complete-blank[data-result="incorrect"]) {
    @apply border-rose-400 bg-rose-400/20 text-white;
  }
  .shiki-complete :global(.blank-select) {
    vertical-align: baseline;
  }
  .shiki-complete :global(.blank-drop[data-active="true"]) {
    @apply ring-2 ring-emerald-400/50;
  }
  .arcade-code-block :global(.shiki) {
    background: transparent !important;
  }
  .arcade-code-block :global(.shiki span) {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  }
</style>

<script define:vars={{ brokenSrcdoc: initialSrcdoc }}>
  // broken srcdoc available for preview toggle
  document.querySelectorAll("[data-challenge][data-type='complete']").forEach((slide) => {
    if (!(slide instanceof HTMLElement)) return;
    const iframe = slide.querySelector<HTMLIFrameElement>("[data-preview-iframe]");
    if (!iframe) return;

    slide.querySelectorAll<HTMLButtonElement>("[data-preview-mode]").forEach((btn) => {
      btn.addEventListener("click", () => {
        slide.querySelectorAll("[data-preview-mode]").forEach((b) => b.setAttribute("data-active", "false"));
        btn.setAttribute("data-active", "true");
        if (btn.dataset.previewMode === "fixed") {
          iframe.srcdoc = brokenSrcdoc;
        } else {
          slide.dispatchEvent(new CustomEvent("arcade:preview-refresh"));
        }
      });
    });
  });
</script>
