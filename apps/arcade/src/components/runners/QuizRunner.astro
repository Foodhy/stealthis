---
import type { QuizChallenge } from "@schema";

interface Props {
  challenge: QuizChallenge;
  index: number;
}

const { challenge, index } = Astro.props;
---

<article
  class="challenge-slide hidden flex-col gap-6 py-10"
  data-challenge
  data-slug={challenge.slug}
  data-answer={challenge.answer}
  data-type="quiz"
  data-index={index}
>
  <div class="space-y-2">
    <span class="text-xs uppercase tracking-wider text-white/40">{challenge.topic}</span>
    <h2 class="text-2xl font-medium leading-snug text-white">{challenge.question}</h2>
  </div>

  <ul class="grid gap-3">
    {challenge.options.map((opt, i) => (
      <li>
        <button
          type="button"
          class="quiz-option flex w-full items-center gap-3 rounded-xl border border-white/8 bg-white/6 px-4 py-3 text-left text-white transition hover:border-white/14 hover:bg-white/8 disabled:cursor-not-allowed disabled:opacity-70"
          data-option-index={i}
        >
          <span class="grid h-6 w-6 place-items-center rounded-md border border-white/14 text-xs tabular-nums text-white/60">
            {i + 1}
          </span>
          <span class="flex-1 text-sm">{opt}</span>
        </button>
      </li>
    ))}
  </ul>

  {challenge.explanation && (
    <div
      class="hidden rounded-xl border border-white/8 bg-white/6 p-4 text-sm leading-relaxed text-white/70"
      data-explanation
    >
      {challenge.explanation}
    </div>
  )}

  <div class="flex items-center justify-end gap-3 pt-2">
    <button
      type="button"
      class="rounded-lg bg-white/8 px-5 py-2.5 text-sm font-medium text-white/80 transition hover:bg-white/14 disabled:cursor-not-allowed disabled:opacity-40"
      data-check
      disabled
    >
      Check
    </button>
    <button
      type="button"
      class="hidden rounded-lg bg-emerald-400 px-5 py-2.5 text-sm font-semibold text-emerald-950 transition hover:bg-emerald-300"
      data-next
    >
      Next
    </button>
  </div>
</article>
