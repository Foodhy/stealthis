---
import Mascot from "./Mascot.astro";

interface Props {
  message: string;
  mood?: "idle" | "happy" | "think" | "celebrate";
  skinId?: string;
  compact?: boolean;
}

const { message, mood = "idle", skinId = "default", compact = false } = Astro.props;
---

<div class:list={["flex items-start gap-4", compact && "gap-3"]} data-mascot-dialogue>
  <div class="shrink-0">
    <Mascot mood={mood} skinId={skinId} size={compact ? 56 : 72} />
  </div>
  <div class="relative min-w-0 flex-1 rounded-2xl border border-white/10 bg-white/6 px-4 py-3 shadow-lg shadow-black/20">
    <div class="absolute -left-2 top-5 h-3 w-3 rotate-45 border-b border-l border-white/10 bg-white/6" aria-hidden="true"></div>
    <p class="text-sm leading-relaxed text-white/85">{message}</p>
  </div>
</div>
