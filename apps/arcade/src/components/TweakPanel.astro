---
import type { FixHint } from "@schema";

interface Props {
  hints?: FixHint[];
  panelId?: string;
}

const { hints = [], panelId = "tweak-panel" } = Astro.props;
---

{hints.length > 0 && (
  <div
    class="tweak-panel rounded-xl border border-white/8 bg-white/6 p-4"
    data-tweak-panel={panelId}
  >
    <p class="text-xs uppercase tracking-wider text-white/40">Suggested tweaks</p>
    <p class="mt-1 hidden text-sm text-white/60" data-pick-info></p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {hints.map((hint, i) => (
        <li>
          <button
            type="button"
            class="rounded-lg border border-white/8 bg-white/6 px-3 py-1.5 text-xs font-medium text-white/80 transition hover:border-emerald-400/40 hover:bg-emerald-400/10 hover:text-white"
            data-hint-index={i}
            data-hint-search={hint.search ?? ""}
            data-hint-insert={hint.insert}
          >
            {hint.label}
          </button>
        </li>
      ))}
    </ul>
    <p class="mt-2 text-xs text-white/40">Click the preview to inspect an element, or use a hint chip.</p>
  </div>
)}
