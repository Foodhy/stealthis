---
import { topicPath } from "../lib/paths";

interface Props {
  topic: string;
  lessonTitle: string;
  total: number;
  difficulties: number[];
}

const { topic, lessonTitle, total, difficulties } = Astro.props;
const maxDifficulty = 5;
---

<header class="sticky top-0 z-10 border-b border-white/8 bg-[#0a0a0a]/95 backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-2 px-4 py-3 sm:gap-3 sm:px-6">
    <a href={topicPath(topic)} class="shrink-0 text-sm text-white/50 hover:text-white">← <span class="hidden sm:inline">{topic}</span></a>
    <span class="min-w-0 flex-1 truncate text-center text-sm font-medium text-white">{lessonTitle}</span>
    <div class="flex shrink-0 items-center gap-3">
      <div class="hidden items-center gap-1 sm:flex" data-pips aria-label="Difficulty">
        {Array.from({ length: maxDifficulty }).map((_, i) => (
          <span
            class="block h-1.5 w-1.5 rounded-full bg-white/14"
            data-pip
            data-pip-index={i}
          />
        ))}
      </div>
      <span
        class="text-xs tabular-nums text-white/40"
        data-progress-text
        data-total={total}
        data-difficulties={JSON.stringify(difficulties)}
      >
        1 / {total}
      </span>
    </div>
  </div>
  <div class="h-1 w-full bg-white/6">
    <div
      class="h-1 bg-emerald-400 transition-[width] duration-200"
      data-progress-bar
      style={`width: ${(1 / total) * 100}%`}
    />
  </div>
</header>
