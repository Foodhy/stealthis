---
interface Props {
  size?: "sm" | "lg";
  label?: string;
  class?: string;
}

const { size = "sm", label = "Play", class: className = "" } = Astro.props;

const dims = size === "lg" ? "h-14 w-14" : "h-9 w-9";
const iconSize = size === "lg" ? 22 : 16;
---

<span
  class:list={[
    "inline-grid shrink-0 place-items-center rounded-full bg-emerald-400 text-emerald-950 shadow-lg shadow-emerald-400/20 transition group-hover:bg-emerald-300",
    dims,
    className,
  ]}
  aria-hidden="true"
>
  <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="currentColor">
    <path d="M8 5v14l11-7z"></path>
  </svg>
</span>
<span class="sr-only">{label}</span>
