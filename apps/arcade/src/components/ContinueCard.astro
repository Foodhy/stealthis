---
import PlayButton from "./PlayButton.astro";

interface Props {
  title: string;
  subtitle: string;
  href: string;
  label?: string;
}

const { title, subtitle, href, label = "Continue" } = Astro.props;
---

<a
  href={href}
  class="group flex items-center gap-4 rounded-2xl border border-emerald-500/40 bg-gradient-to-r from-emerald-500/15 to-transparent p-5 transition hover:border-emerald-400/60 hover:from-emerald-500/25"
  data-continue-card
>
  <PlayButton size="lg" label={label} />
  <div class="min-w-0 flex-1">
    <p class="text-xs uppercase tracking-wider text-emerald-400/80">{label}</p>
    <h2 class="truncate text-lg font-semibold text-white">{title}</h2>
    <p class="truncate text-sm text-white/50">{subtitle}</p>
  </div>
  <span class="text-lg" aria-hidden="true">→</span>
</a>
