---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  hideHeader?: boolean;
  fullBleed?: boolean;
}

const {
  title = "Arcade — stealthis",
  description = "Quick tech challenges. Fix bugs, fill blanks, identify problems — Duolingo-style.",
  hideHeader = false,
  fullBleed = false,
} = Astro.props;

const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://arcade.stealthis.dev"
).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="stealthis arcade" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    {!hideHeader && (
      <header class="border-b border-white/8">
        <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
          <a href="/" class="text-sm font-semibold tracking-tight text-white">
            stealthis <span class="text-white/40">/ arcade</span>
          </a>
          <nav class="text-sm text-white/60">
            <a href="/" class="hover:text-white">Paths</a>
            <span class="mx-2 text-white/20">·</span>
            <a href="/explore" class="hover:text-white">Explore</a>
            <span class="mx-2 text-white/20">·</span>
            <a href="/profile" class="hover:text-white">Profile</a>
          </nav>
        </div>
      </header>
    )}
    {fullBleed ? (
      <slot />
    ) : (
      <main class="mx-auto max-w-5xl px-6 py-10">
        <slot />
      </main>
    )}
  </body>
</html>
