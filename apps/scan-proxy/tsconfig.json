{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["@cloudflare/workers-types"],
    "lib": ["ESNext"],
    "skipLibCheck": true,
    "noEmit": true
  },
  // Los tests corren con `bun test`, que trae sus propios tipos (bun:test).
  // Mezclarlos aquí obligaría a cargar bun-types junto a workers-types, que
  // declaran globals incompatibles.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
