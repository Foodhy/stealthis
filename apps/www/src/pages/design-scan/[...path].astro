---
import DesignScan from "@components/DesignScan.tsx";
import { getAlternateLinks, getLocaleFromUrl, useTranslations } from "@i18n/index";
import Base from "@layouts/Base.astro";

/**
 * Ruta solo de desarrollo.
 *
 * /design-scan hace que un worker propio salga a internet a buscar la URL que
 * le peguen. Publicarlo en stealthis.dev seria ofrecer ese fetcher a cualquiera
 * — el CORS solo frena a los navegadores, no a curl.
 *
 * Al ser una ruta dinamica, en produccion `getStaticPaths` no devuelve ningun
 * camino y Astro no emite el HTML. Se cierra la RUTA, no solo el enlace del
 * menu: esconder el enlace dejaria la URL accesible a quien la escriba.
 */
export function getStaticPaths() {
  if (import.meta.env.PROD) return [];
  return [{ params: { path: undefined } }];
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const alternateLinks = getAlternateLinks("/design-scan");
---

<Base
  title={t("designScan.title")}
  description={t("designScan.description")}
  canonicalPath="/design-scan"
  alternateLinks={alternateLinks}
>
  <section class="container-xl py-16 pb-20">
    <header class="mb-10 max-w-2xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-brand-300">
        {t("designScan.eyebrow")}
      </p>
      <h1 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
        {t("designScan.heading")}
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-slate-400">
        {t("designScan.intro")}
      </p>
    </header>

    <DesignScan client:only="react" />
  </section>
</Base>
