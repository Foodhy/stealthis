---
import type { DesignScanCopy } from "@components/DesignScan.tsx";
import DesignScanIsland from "@components/DesignScanIsland.tsx";
import { getAlternateLinks, getLocaleFromUrl, useTranslations } from "@i18n/index";
import Base from "@layouts/Base.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const alternateLinks = getAlternateLinks("/design-scan");

const copy: DesignScanCopy = {
  proxyLead: t("designScan.proxy.lead"),
  proxyPanelTitle: t("designScan.proxy.panelTitle"),
  proxyUseThis: t("designScan.proxy.useThis"),
  proxyReset: t("designScan.proxy.reset"),
  proxyCopyStart: t("designScan.proxy.copyStart"),
  proxyCopied: t("designScan.proxy.copied"),
  proxyStop: t("designScan.proxy.stop"),
  proxyStopFailed: t("designScan.proxy.stopFailed"),
  proxyStatusUp: t("designScan.proxy.statusUp"),
  proxyStatusChecking: t("designScan.proxy.statusChecking"),
  proxyStatusDown: t("designScan.proxy.statusDown"),
  proxyStatusUnknown: t("designScan.proxy.statusUnknown"),
  proxySavedHint: t("designScan.proxy.savedHint"),
};

const siteOrigin = Astro.site?.origin ?? "https://stealthis.dev";
---

<Base
  title={t("designScan.title")}
  description={t("designScan.description")}
  canonicalPath="/design-scan"
  alternateLinks={alternateLinks}
>
  <section class="container-xl py-16 pb-20">
    <header class="mb-10 max-w-2xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-brand-300">
        {t("designScan.eyebrow")}
      </p>
      <h1 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
        {t("designScan.heading")}
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-slate-400">
        {t("designScan.intro")}
      </p>
    </header>

    <DesignScanIsland client:only="react" copy={copy} siteOrigin={siteOrigin} />
  </section>
</Base>
