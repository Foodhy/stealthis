---
import Base from "@layouts/Base.astro";
import { APPLICATIONS, type AppIcon } from "@lib/applications";
import { getAlternateLinks, getLocaleFromUrl, getLocalePrefix, useTranslations } from "@i18n/index";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const prefix = getLocalePrefix(locale);
const canonicalPath = `${prefix}/applications`;
const alternateLinks = getAlternateLinks("/applications/");

const labels = { demo: t("apps.demo"), repo: t("apps.repo") };

// Localized cards: app description comes from i18n (apps.<slug>.desc), falling
// back to the English desc in the data module if a key is ever missing.
const cards = APPLICATIONS.map((app) => ({
  ...app,
  desc: t(`apps.${app.slug}.desc` as Parameters<typeof t>[0]) || app.desc,
}));

// Inline icon paths (stroke="currentColor"), keyed by AppEntry.icon.
const ICONS: Record<AppIcon, string> = {
  dbviz:
    '<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v6c0 1.657 4.03 3 9 3s9-1.343 9-3V5"></path><path d="M3 11v6c0 1.657 4.03 3 9 3s9-1.343 9-3v-6"></path>',
  zenpomodoro:
    '<circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2 2"></path><path d="M9 2h6"></path>',
  video:
    '<rect x="2" y="6" width="14" height="12" rx="2"></rect><path d="m22 8-6 4 6 4V8z"></path>',
  record:
    '<rect x="3" y="5" width="18" height="14" rx="2"></rect><circle cx="12" cy="12" r="3"></circle>',
  office:
    '<rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path>',
  gitbattle:
    '<circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="18" r="3"></circle><path d="M6 9v3a3 3 0 0 0 3 3h6"></path><path d="M13 12l3 3-3 3"></path>',
};
---

<Base
  title={t("apps.page.title")}
  description={t("apps.page.desc")}
  image="/og/applications.webp"
  canonicalPath={canonicalPath}
  alternateLinks={alternateLinks}
>
  <div class="container-xl py-12">
    <div class="mb-10">
      <h1 class="text-4xl font-extrabold tracking-tight text-white mb-2">{t("apps.page.title")}</h1>
      <p class="text-slate-400">{t("apps.page.desc")}</p>
    </div>

    <section class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
      {cards.map((app) => {
        const primary = app.demoHref ?? app.repoHref;
        return (
          <article class="app-card group flex flex-col overflow-hidden rounded-xl border border-white/6 bg-surface-950 transition-colors hover:border-brand-400/40">
            <a
              href={primary}
              target="_blank"
              rel="noopener noreferrer"
              class="block aspect-[16/10] overflow-hidden bg-surface-900"
              aria-label={app.name}
            >
              <img
                src={app.image}
                alt={`${app.name} preview`}
                width="1200"
                height="750"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-left-top transition-transform duration-300 group-hover:scale-[1.03]"
              />
            </a>
            <div class="flex flex-1 flex-col gap-3 p-5">
              <div class="flex items-center gap-2.5">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-white/8 bg-white/5 text-brand-300">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={ICONS[app.icon]} />
                </span>
                <h2 class="text-lg font-bold text-white">{app.name}</h2>
              </div>
              <p class="flex-1 text-sm leading-relaxed text-slate-400">{app.desc}</p>
              <div class="flex flex-wrap gap-2 pt-1">
                {app.demoHref && (
                  <a
                    href={app.demoHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg bg-brand-500 px-3 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-brand-400"
                    {...(app.slug === "dbviz" ? { "data-dbviz-trigger": "" } : {})}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    {labels.demo}
                  </a>
                )}
                {app.repoHref && (
                  <a
                    href={app.repoHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-sm font-semibold text-slate-200 transition-colors hover:bg-white/10 hover:text-white"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"></path>
                    </svg>
                    {labels.repo}
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </section>
  </div>
</Base>
