---
import type { Locale } from "@i18n/index";
import { getLocalePrefix, useTranslations } from "@i18n/index";
import { SITE_URLS } from "@lib/urls";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = getLocalePrefix(locale);
---

<footer class="border-t border-white/6">
  <div class="container-xl py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500">
    <div class="flex items-center gap-2">
      <span class="text-brand-400">✦</span>
      <span>StealThis.dev</span>
      <span>—</span>
      <span>Open Source</span>
    </div>

    <div class="flex items-center gap-4">
      <a href={`${prefix}/library`} class="hover:text-slate-300 transition-colors">Library</a>
      <a href={SITE_URLS.docs} target="_blank" rel="noopener" class="hover:text-slate-300 transition-colors">Docs</a>
      <a href={SITE_URLS.lab} target="_blank" rel="noopener" class="hover:text-slate-300 transition-colors">Lab</a>
      <a href={`${prefix}/skills`} class="hover:text-slate-300 transition-colors">{t("nav.skills")}</a>
      <a href={`${prefix}/changelog`} class="hover:text-slate-300 transition-colors">{t("nav.changelog")}</a>
      <a href="https://github.com/Foodhy/stealthis" target="_blank" rel="noopener" class="hover:text-slate-300 transition-colors">GitHub</a>
    </div>

    <div class="flex items-center gap-3">
      <a
        href={SITE_URLS.buyMeACoffee}
        target="_blank"
        rel="noopener noreferrer"
        class="bmc-link"
        aria-label="Buy me a coffee"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 8h1.5a3.5 3.5 0 1 1 0 7H17"></path>
          <path d="M3 8h14v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
          <path d="M6 2v2M10 2v2M14 2v2"></path>
        </svg>
        <span>Buy me a coffee</span>
      </a>
      <span>MIT License</span>
    </div>
  </div>
</footer>

<style>
  .bmc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.7rem 0.32rem 0.55rem;
    border-radius: 999px;
    background: #ffdd00;
    color: #0d0c22;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 0 0 1px rgba(255, 221, 0, 0.35);
    transition: transform 140ms ease, filter 140ms ease, box-shadow 140ms ease;
  }

  .bmc-link:hover {
    color: #0d0c22;
    filter: brightness(1.06);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(255, 221, 0, 0.22);
  }

  .bmc-link svg {
    flex-shrink: 0;
  }
</style>
