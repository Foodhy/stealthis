---
import { type Locale, getLocalePrefix, useTranslations } from "@i18n/index";
import { IS_NEW_RECOMMENDATIONS_SECTION } from "@lib/collections";
import { getCategoryIcon, getCollectionIcon } from "@lib/icons";

interface SidebarCollection {
  id: string;
  title: string;
  count: number;
  isNew: boolean;
}

interface Props {
  locale?: Locale;
  categories: string[];
  categoryCounts: Record<string, number>;
  collections: SidebarCollection[];
  techs: string[];
  authors: string[];
  totalCount: number;
}

const {
  locale = "en",
  categories,
  categoryCounts,
  collections,
  techs,
  authors,
  totalCount,
} = Astro.props;
const t = useTranslations(locale);
const libPath = `${getLocalePrefix(locale)}/library`;

const L = {
  allResources: t("library.sidebar.allResources"),
  collections: t("library.sidebar.collections"),
  collectionSearch: t("library.sidebar.filterCollections"),
};

const difficulties = ["easy", "med", "hard"] as const;
const TECH_LABELS: Record<string, string> = {
  js: "JS",
  css: "CSS",
  html: "HTML",
  react: "React",
  "react-native": "React Native",
  expo: "Expo",
  next: "Next.js",
  vue: "Vue",
  svelte: "Svelte",
  astro: "Astro",
  typescript: "TypeScript",
  markdown: "Markdown",
  yaml: "YAML",
  json: "JSON",
  python: "Python",
  sql: "SQL",
  mermaid: "Mermaid",
  dbml: "DBML",
};

const formatTechLabel = (value: string) => TECH_LABELS[value] ?? value;
---

<div class="filter-bar flex flex-col gap-5" id="filter-bar">
  <!-- Search -->
  <div class="relative">
    <svg
      class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 pointer-events-none"
      width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
    >
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
    </svg>
    <input
      id="search-input"
      type="search"
      placeholder={t("library.search.placeholder")}
      class="w-full pl-9 pr-4 py-2.5 rounded-xl bg-surface-900 border border-white/8 text-sm text-slate-300 placeholder:text-slate-600 focus:outline-none focus:border-brand-500/50 focus:ring-1 focus:ring-brand-500/30 transition-colors"
    />
  </div>

  <!-- Quick views -->
  <div class="flex flex-col gap-1">
    <button class="side-row" data-filter-reset type="button">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0">
        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
      </svg>
      <span class="side-row-label">{L.allResources}</span>
      <span class="side-row-count">{totalCount}</span>
    </button>
    <button id="favorites-filter-btn" class="side-row" type="button">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
      <span class="side-row-label">{t("library.filter.favorites")}</span>
    </button>
  </div>

  <!-- Category filter -->
  <div>
    <p class="side-heading">{t("library.filter.category")}</p>
    <div class="flex flex-col gap-0.5">
      <button class="side-row chip--active" data-filter="category" data-value="all" type="button">
        <span class="side-row-glyph" aria-hidden="true">◆</span>
        <span class="side-row-label">{t("library.filter.all")}</span>
        <span class="side-row-count">{totalCount}</span>
      </button>
      {categories.map((cat) => {
        const key = `category.${cat}` as
          | "category.web-animations" | "category.web-pages" | "category.ui-components" | "category.patterns"
          | "category.components" | "category.pages" | "category.prompts" | "category.skills"
          | "category.mcp-servers" | "category.architectures" | "category.boilerplates" | "category.remotion"
          | "category.database-schemas"
          | "category.ultra-high-definition-pages"
          | "category.design-styles"
          | "category.music"
          | "category.3d-models"
          | "category.3d-interactions"
          | "category.recommendations";
        const isNew = cat === "recommendations" && IS_NEW_RECOMMENDATIONS_SECTION;
        return (
          <button class="side-row" data-filter="category" data-value={cat} type="button">
            <span class="side-row-glyph" aria-hidden="true">{getCategoryIcon(cat)}</span>
            <span class="side-row-label">
              {t(key)}
              {isNew && <span class="lib-new-badge">{t("badge.new")}</span>}
            </span>
            <span class="side-row-count">{categoryCounts[cat] ?? 0}</span>
          </button>
        );
      })}
    </div>
  </div>

  <!-- Collections -->
  <div>
    <p class="side-heading">{L.collections}</p>
    <div class="relative mb-2">
      <svg
        class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-600 pointer-events-none"
        width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
      >
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input
        id="collection-filter-input"
        type="search"
        placeholder={L.collectionSearch}
        autocomplete="off"
        class="w-full pl-7 pr-3 py-1.5 rounded-lg bg-surface-900 border border-white/6 text-xs text-slate-300 placeholder:text-slate-600 focus:outline-none focus:border-brand-500/40 transition-colors"
      />
    </div>
    <div class="flex flex-col gap-0.5 max-h-72 overflow-y-auto pr-1" id="collection-list">
      <button class="side-row chip--active" data-filter="collection" data-value="all" data-label="all" type="button">
        <span class="side-row-glyph" aria-hidden="true">◆</span>
        <span class="side-row-label">{t("library.filter.all")}</span>
      </button>
      {collections.map((c) => (
        <button
          class="side-row"
          data-filter="collection"
          data-value={c.id}
          data-label={c.title.toLowerCase()}
          type="button"
        >
          <span class="side-row-glyph" aria-hidden="true">{getCollectionIcon(c.id)}</span>
          <span class="side-row-label">
            <span class="side-row-name">{c.title}</span>
            {c.isNew && <span class="lib-new-badge">{t("badge.new")}</span>}
          </span>
          <span class="side-row-count">{c.count}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Difficulty filter -->
  <div>
    <p class="side-heading">{t("library.filter.difficulty")}</p>
    <div class="flex flex-wrap gap-1.5">
      <button class="chip chip--compact chip--active" data-filter="difficulty" data-value="all" type="button">{t("library.filter.all")}</button>
      {difficulties.map((d) => {
        const key = `resource.difficulty.${d}` as "resource.difficulty.easy" | "resource.difficulty.med" | "resource.difficulty.hard";
        return (
          <button class="chip chip--compact" data-filter="difficulty" data-value={d} type="button">{t(key)}</button>
        );
      })}
    </div>
  </div>

  <!-- Tech filter -->
  <div>
    <p class="side-heading">{t("library.filter.tech")}</p>
    <div class="flex flex-wrap gap-1.5" id="tech-chips">
      <button class="chip chip--compact chip--active" data-filter="tech" data-value="all" type="button">{t("library.filter.all")}</button>
      {techs.slice(0, 20).map((tech) => (
        <button class="chip chip--compact" data-filter="tech" data-value={tech} type="button">{formatTechLabel(tech)}</button>
      ))}
    </div>
  </div>

  <!-- Author filter — uses <a> links so URL is source of truth -->
  {authors.length > 0 && (
    <details class="group">
      <summary class="side-heading cursor-pointer select-none list-none flex items-center gap-1">
        {t("library.filter.author")}
        <svg class="transition-transform group-open:rotate-90" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </summary>
      <div class="flex flex-wrap gap-1.5 mt-2">
        <a href={libPath} class="chip chip--compact chip--active" data-filter="author" data-value="all">
          {t("library.filter.all")}
        </a>
        {authors.map((handle) => (
          <a
            href={`${libPath}?author=${handle}`}
            class="chip chip--compact"
            data-filter="author"
            data-value={handle}
          >
            @{handle}
          </a>
        ))}
      </div>
    </details>
  )}

  <!-- Results count -->
  <p class="text-xs text-slate-600" id="results-count"></p>

  <!-- Favorites export / import -->
  <div class="flex flex-col gap-2 border-t border-white/6 pt-4">
    <button
      id="export-favorites"
      class="w-full text-sm font-medium px-4 py-2.5 rounded-xl border border-white/10 text-slate-400 hover:text-slate-200 hover:bg-white/6 transition-colors text-left"
    >
      ↑ {t("favorites.export")}
    </button>
    <label class="w-full text-sm font-medium px-4 py-2.5 rounded-xl border border-white/10 text-slate-400 hover:text-slate-200 hover:bg-white/6 transition-colors cursor-pointer">
      ↓ {t("favorites.import")}
      <input type="file" accept=".json" class="hidden" id="import-favorites-input" />
    </label>
  </div>
</div>

<script>
  import { LIBRARY_INITIAL_REVEAL } from "@lib/constant";

  const FAVORITES_KEY = "stealthis:favorites";
  function getFavoriteSlugs(): Set<string> {
    try {
      const raw = localStorage.getItem(FAVORITES_KEY);
      return new Set(raw ? JSON.parse(raw) : []);
    } catch { return new Set(); }
  }

  const state = {
    collection: "all",
    category: "all",
    difficulty: "all",
    tech: "all",
    author: "all",
    favoritesOnly: false,
    previewsEnabled: true,
    search: "",
    indexedResults: null as Set<string> | null,
  };

  const cards = document.querySelectorAll<HTMLElement>("article[data-slug]");
  const resultsCount = document.getElementById("results-count");

  // Precompute each card's filterable fields ONCE. The title/description live in
  // the DOM (h2 + 2nd <p>); reading them per-card on every keystroke was the main
  // synchronous cost. Cache them so applyFilters() never touches the DOM to decide.
  interface CardMeta {
    collections: string[];
    category: string;
    difficulty: string;
    tech: string[];
    slug: string;
    author: string;
    title: string;
    desc: string;
  }
  const cardMeta = new Map<HTMLElement, CardMeta>();
  cards.forEach((card) => {
    cardMeta.set(card, {
      collections: (card.dataset.collections ?? "").split(",").filter(Boolean),
      category: card.dataset.category ?? "",
      difficulty: card.dataset.difficulty ?? "",
      tech: (card.dataset.tech ?? "").split(","),
      slug: card.dataset.slug ?? "",
      author: card.dataset.author ?? "",
      title: (card.querySelector("h2")?.textContent ?? "").toLowerCase(),
      desc: (card.querySelector("p:nth-of-type(2)")?.textContent ?? "").toLowerCase(),
    });
  });

  // --- Collection preview mode -------------------------------------------------
  // When a single collection is selected, matching cards render showcase-style
  // with a live preview (lab demo, or the resource detail page as fallback).
  // Iframes load lazily as cards scroll into view so we never fetch all at once.
  const labBaseUrl = document.querySelector<HTMLElement>("[data-lab-url]")?.dataset.labUrl ?? "";

  // The demo iframe is laid out at this logical width, then scaled to cover the
  // preview box (see sizeCardPreview). Single tunable knob: lower = content
  // bigger / less page; higher = more page / smaller content.
  const PREVIEW_LOGICAL_WIDTH = 600;

  function previewSrcFor(card: HTMLElement): string {
    const labRoute = card.dataset.labRoute ?? "";
    const slug = card.dataset.slug ?? "";
    // Trailing slash is the canonical form — without it both lab routes and /r/
    // pages answer 308 and the iframe wastes a round-trip chasing the redirect
    // (and logs noise to the console). Request the final URL directly.
    let url = labRoute && labBaseUrl ? `${labBaseUrl}${labRoute}` : `/r/${slug}`;
    if (!url.endsWith("/")) url += "/";
    return url;
  }

  function sizeCardPreview(card: HTMLElement) {
    const wrap = card.querySelector<HTMLElement>("[data-card-preview]");
    const iframe = card.querySelector<HTMLIFrameElement>("[data-card-preview-iframe]");
    if (!wrap || !iframe) return;
    const w = wrap.offsetWidth;
    const h = wrap.offsetHeight;
    if (w <= 0 || h <= 0) return; // card not laid out yet; the ResizeObserver retries
    // Cover-fill: render at the logical width, then scale so the iframe exactly
    // fills the box (top-aligned). Logical height = h / scale so scaled height
    // === box height — no dark gap below, content spans the full width.
    const scale = w / PREVIEW_LOGICAL_WIDTH;
    iframe.style.width = `${PREVIEW_LOGICAL_WIDTH}px`;
    iframe.style.height = `${Math.ceil(h / scale)}px`;
    iframe.style.transform = `scale(${scale})`;
  }

  // Re-scale a preview whenever its box gets a real (or changed) width. Fires once
  // as soon as the card is laid out, so the scale is never stuck at a stale value.
  const previewSizeObserver =
    "ResizeObserver" in window
      ? new ResizeObserver((entries) => {
          for (const entry of entries) {
            const card = (entry.target as HTMLElement).closest<HTMLElement>("article[data-slug]");
            if (card) sizeCardPreview(card);
          }
        })
      : null;

  // Throttled, lazy preview loader. Cards entering the viewport are queued; at
  // most MAX_CONCURRENT iframes load at a time so we never stampede the network
  // or the main thread with 50+ full lab pages at once. A status pill reports
  // progress so the user always knows previews are still loading.
  const MAX_CONCURRENT_PREVIEWS = 4;
  const loadQueue: HTMLElement[] = [];
  let activeLoads = 0;

  // Floating "loading previews" status pill.
  const loadStatus = document.createElement("div");
  loadStatus.id = "preview-load-status";
  loadStatus.setAttribute("aria-live", "polite");
  loadStatus.hidden = true;
  loadStatus.innerHTML = `<span class="preview-load-spinner" aria-hidden="true"></span><span class="preview-load-text"></span>`;
  document.body.appendChild(loadStatus);
  const loadStatusText = loadStatus.querySelector<HTMLElement>(".preview-load-text");

  function updateLoadStatus() {
    const remaining = activeLoads + loadQueue.length;
    if (remaining > 0) {
      if (loadStatusText) {
        loadStatusText.textContent = `Loading previews… ${remaining}`;
      }
      loadStatus.hidden = false;
    } else {
      loadStatus.hidden = true;
    }
    // Let the "Show previews" toggle reflect loading state on the button itself.
    window.dispatchEvent(
      new CustomEvent("stealthis:previews-loading", { detail: { remaining } })
    );
  }

  const previewObserver =
    "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries, observer) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const card = entry.target as HTMLElement;
              observer.unobserve(card);
              queuePreview(card);
            }
          },
          { rootMargin: "300px" }
        )
      : null;

  function queuePreview(card: HTMLElement) {
    const wrap = card.querySelector<HTMLElement>("[data-card-preview]");
    // Already has an iframe (loading or loaded) or already queued → skip.
    if (!wrap || wrap.querySelector("iframe") || loadQueue.includes(card)) return;
    loadQueue.push(card);
    updateLoadStatus();
    pumpQueue();
  }

  function pumpQueue() {
    while (activeLoads < MAX_CONCURRENT_PREVIEWS && loadQueue.length > 0) {
      const card = loadQueue.shift();
      if (card && card.classList.contains("is-preview")) startLoad(card);
    }
  }

  function startLoad(card: HTMLElement) {
    const wrap = card.querySelector<HTMLElement>("[data-card-preview]");
    if (!wrap || wrap.querySelector("iframe")) return;
    activeLoads++;

    // Iframes are created here, on demand — never in the server HTML. With 1000+
    // lab-route cards, rendering an <iframe> per card up front spawned 1000+
    // about:blank documents (heavy, and a wall of sandbox-escape warnings).
    // Lazy creation — not the sandbox flags — is what fixed that.
    // sandbox needs BOTH allow-scripts and allow-same-origin: lab previews are
    // Astro pages whose type=module scripts are fetched under CORS, and an
    // opaque ('null') origin would get those blocked, leaving the preview blank.
    const iframe = document.createElement("iframe");
    iframe.className = "card-preview-iframe";
    iframe.setAttribute("data-card-preview-iframe", "");
    iframe.setAttribute("sandbox", "allow-scripts allow-same-origin");
    iframe.setAttribute("loading", "lazy");
    iframe.setAttribute("title", wrap.dataset.previewTitle ?? "Live preview");

    const finish = () => {
      activeLoads--;
      wrap.classList.add("is-loaded");
      sizeCardPreview(card);
      updateLoadStatus();
      pumpQueue();
    };
    iframe.addEventListener("load", finish, { once: true });
    iframe.addEventListener("error", finish, { once: true });
    wrap.appendChild(iframe);
    sizeCardPreview(card);
    previewSizeObserver?.observe(wrap);
    iframe.src = previewSrcFor(card);
  }

  function clearCardPreview(card: HTMLElement) {
    card.classList.remove("is-preview");
    if (previewObserver) previewObserver.unobserve(card);
    const queueIdx = loadQueue.indexOf(card);
    if (queueIdx !== -1) loadQueue.splice(queueIdx, 1);
    const wrap = card.querySelector<HTMLElement>("[data-card-preview]");
    wrap?.classList.remove("is-loaded");
    if (wrap) previewSizeObserver?.unobserve(wrap);
    // Destroy the iframe entirely so the off-screen card costs nothing again.
    wrap?.querySelector("iframe")?.remove();
    updateLoadStatus();
  }

  function enableCardPreview(card: HTMLElement) {
    // Only cards that actually have a preview slot (i.e. a lab route) opt in.
    if (!card.querySelector("[data-card-preview]")) return;
    card.classList.add("is-preview");
    if (previewObserver) {
      previewObserver.observe(card);
    } else {
      queuePreview(card);
    }
  }

  // (Per-preview ResizeObserver above handles re-scaling — no global resize
  // listener needed.)

  const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
  let searchTimer: number | undefined;
  let searchIndexPromise: Promise<Map<string, string> | null> | null = null;
  let searchRequestId = 0;

  async function loadSearchIndex(): Promise<Map<string, string> | null> {
    if (searchIndexPromise) return searchIndexPromise;

    searchIndexPromise = fetch("/library-index.json", {
      headers: { Accept: "application/json" },
    })
      .then(async (response) => {
        if (!response.ok) return null;
        const payload = await response.json();
        const resources = Array.isArray(payload?.resources) ? payload.resources : [];
        const index = new Map<string, string>();

        for (const resource of resources) {
          if (typeof resource?.slug !== "string") continue;

          const rawSearchText =
            typeof resource?.searchText === "string"
              ? resource.searchText
              : [
                  resource?.title,
                  resource?.description,
                  ...(Array.isArray(resource?.tags) ? resource.tags : []),
                  ...(Array.isArray(resource?.tech) ? resource.tech : []),
                ].join(" ");

          index.set(resource.slug, rawSearchText.toLowerCase());
        }

        return index;
      })
      .catch(() => null);

    return searchIndexPromise;
  }

  async function runIndexedSearch(query: string): Promise<Set<string> | null> {
    const index = await loadSearchIndex();
    if (!index) return null;

    const matches = new Set<string>();
    for (const [slug, text] of index.entries()) {
      if (text.includes(query)) matches.add(slug);
    }

    return matches;
  }

  let currentFavs: Set<string> = new Set();

  function matches(card: HTMLElement): boolean {
    const meta = cardMeta.get(card);
    if (!meta) return false;

    if (state.collection !== "all" && !meta.collections.includes(state.collection)) return false;
    if (state.category !== "all" && meta.category !== state.category) return false;
    if (state.difficulty !== "all" && meta.difficulty !== state.difficulty) return false;
    if (state.tech !== "all" && !meta.tech.includes(state.tech)) return false;
    if (state.author !== "all" && meta.author !== state.author) return false;
    if (state.favoritesOnly && !currentFavs.has(meta.slug)) return false;
    if (state.search) {
      if (state.indexedResults) {
        if (!state.indexedResults.has(meta.slug)) return false;
      } else if (!meta.title.includes(state.search) && !meta.desc.includes(state.search)) {
        return false;
      }
    }

    return true;
  }

  let pendingScroll = false;
  // Auto-scroll to results only where the grid isn't already beside the filters
  // (mobile drawer). With the sticky desktop sidebar it just feels jumpy.
  const isMobileViewport = () => window.matchMedia("(max-width: 1023px)").matches;

  // --- URL write-back ---------------------------------------------------------
  // Keep the address bar in sync with active filters so state survives refresh
  // and can be shared. replaceState only — no history spam. ?mode= is owned by
  // the mode-switcher in the page script and is left untouched here.
  const URL_FILTER_KEYS = ["collection", "category", "difficulty", "tech", "author"] as const;
  function syncUrl() {
    const url = new URL(window.location.href);
    for (const key of URL_FILTER_KEYS) {
      if (state[key] !== "all") url.searchParams.set(key, state[key]);
      else url.searchParams.delete(key);
    }
    if (state.search) url.searchParams.set("search", state.search);
    else url.searchParams.delete("search");
    history.replaceState(history.state, "", url.toString());
  }

  // --- Infinite scroll --------------------------------------------------------
  // 1621 cards is too many to paint at once. We compute the full match set but
  // only reveal it in batches; a sentinel near the page bottom reveals the next
  // batch as the user scrolls. Hidden-but-matching cards cost nothing (they are
  // display:none) and previews only attach to revealed cards, so the iframe
  // storm that made "Show previews" choke is bounded too.
  // Shared with the static markup in pages/library/index.astro, which ships the
  // first INITIAL_REVEAL cards visible and the rest display:none — so this first
  // pass is a no-op instead of collapsing 2000 painted cards down to 48.
  const INITIAL_REVEAL = LIBRARY_INITIAL_REVEAL;
  const REVEAL_STEP = 48;
  let revealCount = INITIAL_REVEAL;
  let matchedCards: HTMLElement[] = [];

  const sentinel = document.getElementById("infinite-sentinel");
  const sentinelObserver =
    sentinel && "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting && revealCount < matchedCards.length) {
                revealCount += REVEAL_STEP;
                renderReveal();
              }
            }
          },
          { rootMargin: "600px" }
        )
      : null;
  if (sentinel && sentinelObserver) sentinelObserver.observe(sentinel);

  // Compute which cards match, then hand off to renderReveal() for the batched
  // display pass. resetReveal=true (the default) restarts paging from the top —
  // every filter/search change; the sentinel calls renderReveal() directly to
  // grow the window without recomputing matches.
  function applyFilters(resetReveal = true) {
    // Read favorites once per pass instead of once per card.
    currentFavs = state.favoritesOnly ? getFavoriteSlugs() : currentFavs;

    // Order by current DOM position (live query) so "first N revealed" follows
    // what the user sees — important in "latest" mode where cards are reparented
    // into #flat-grid in date order. Scoped to #resource-grid so discover-mode
    // card clones (rendered in a separate container) are never touched.
    const gridRoot = document.getElementById("resource-grid") ?? document;
    const ordered = gridRoot.querySelectorAll<HTMLElement>("article[data-slug]");
    matchedCards = [];
    ordered.forEach((card) => {
      if (matches(card)) {
        matchedCards.push(card);
      } else {
        card.style.display = "none";
        clearCardPreview(card);
      }
    });

    if (resetReveal) revealCount = INITIAL_REVEAL;
    renderReveal();
  }

  function renderReveal() {
    let visible = 0;
    const visibleSlugs = new Set<string>();
    // Previews work in any view (default "all" browse or a specific collection).
    // Lazy IntersectionObserver + MAX_CONCURRENT_PREVIEWS cap keep the iframe
    // load bounded to on-screen cards, so no throttle-by-collection is needed.
    const previewMode = state.previewsEnabled;
    const limit = Math.min(revealCount, matchedCards.length);

    matchedCards.forEach((card, i) => {
      if (i < limit) {
        card.style.display = "";
        visible++;
        visibleSlugs.add(card.dataset.slug ?? "");
        if (previewMode) enableCardPreview(card);
        else clearCardPreview(card);
      } else {
        card.style.display = "none";
        clearCardPreview(card);
      }
    });

    // Sentinel only matters while there are more matches to reveal.
    if (sentinel) sentinel.style.display = limit < matchedCards.length ? "" : "none";

    // Hide category sections with no visible cards (use slug set for reliability)
    document.querySelectorAll<HTMLElement>("[data-category-section]").forEach((section) => {
      const hasVisible = [...section.querySelectorAll<HTMLElement>("[data-slug]")]
        .some((c) => visibleSlugs.has(c.dataset.slug ?? ""));
      section.style.display = hasVisible ? "" : "none";
    });

    // Hide category groups with no visible sections
    document.querySelectorAll<HTMLElement>("[data-category-group]").forEach((group) => {
      const hasVisible = [...group.querySelectorAll<HTMLElement>("[data-category-section]")]
        .some((s) => s.style.display !== "none");
      group.style.display = hasVisible ? "" : "none";
    });

    // In "latest" mode (flat-grid visible), hide the grid container when empty
    // so the "no results" message appears without dead space above it.
    const flatGrid = document.getElementById("flat-grid");
    if (flatGrid && !flatGrid.classList.contains("hidden")) {
      flatGrid.style.display = visible > 0 ? "" : "none";
    }

    // Show/hide empty state
    const emptyState = document.getElementById("empty-state");
    if (emptyState) emptyState.classList.toggle("hidden", visible > 0);

    if (resultsCount) {
      const total = matchedCards.length;
      resultsCount.textContent =
        visible < total
          ? `${visible} of ${total} resources`
          : `${total} resource${total !== 1 ? "s" : ""}`;
    }

    // Scroll to the resource grid so filtered results are immediately visible
    if (pendingScroll) {
      pendingScroll = false;
      const grid = document.getElementById("resource-grid");
      if (grid && visible > 0) {
        requestAnimationFrame(() => {
          grid.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      }
    }
  }

  // --- Active collection pill --------------------------------------------------
  // Small dismissible pill above the grid showing the selected collection, since
  // the sidebar may be scrolled or (on mobile) closed when results render.
  const collectionPill = document.getElementById("active-collection-pill");
  const collectionPillLabel = collectionPill?.querySelector<HTMLElement>("[data-pill-label]");
  function syncCollectionPill() {
    if (!collectionPill) return;
    if (state.collection === "all") {
      collectionPill.classList.add("hidden");
      return;
    }
    const activeBtn = document.querySelector<HTMLElement>(
      `[data-filter="collection"][data-value="${state.collection}"] .side-row-label`
    );
    if (collectionPillLabel) {
      // Title lives in .side-row-name (the first child node is whitespace, so
      // childNodes[0] alone yields an empty pill). Fall back to the raw ID.
      collectionPillLabel.textContent =
        activeBtn?.querySelector(".side-row-name")?.textContent?.trim() ||
        activeBtn?.childNodes[0]?.textContent?.trim() ||
        state.collection;
    }
    collectionPill.classList.remove("hidden");
  }
  collectionPill?.querySelector("[data-pill-clear]")?.addEventListener("click", () => {
    setFilter("collection", "all");
  });

  function setFilter(filter: "collection" | "category" | "difficulty" | "tech" | "author", value: string, apply = true) {
    const filterElements = document.querySelectorAll<HTMLElement>(`[data-filter="${filter}"]`);
    const allowedValues = new Set(
      [...filterElements].map((element) => element.dataset.value ?? "all")
    );
    if (!allowedValues.has(value)) return;

    state[filter] = value;

    filterElements.forEach((element) => {
      element.classList.toggle("chip--active", element.dataset.value === value);
    });

    if (filter === "collection") {
      syncCollectionPill();
      // The sort chips (page script) force "By category" while a collection is
      // active and restore the user's last pick on "All".
      window.dispatchEvent(
        new CustomEvent("stealthis:collection-changed", { detail: { collection: value } })
      );
    }

    if (apply) {
      applyFilters();
      syncUrl();
    }
  }

  // Filter buttons
  document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter as "collection" | "category" | "difficulty" | "tech" | "author";
      const value = btn.dataset.value ?? "all";

      // Collections always scroll back to the top of the results — the sidebar
      // list is long, so the click usually happens with the page scrolled deep.
      if (value !== "all" && (filter === "collection" || isMobileViewport())) pendingScroll = true;
      setFilter(filter, value);
    });
  });

  // Reset button ("All resources" quick view): back to the default view.
  document.querySelectorAll<HTMLButtonElement>("[data-filter-reset]").forEach((btn) => {
    btn.addEventListener("click", () => {
      state.collection = "all";
      state.category = "all";
      state.difficulty = "all";
      state.tech = "all";
      state.author = "all";
      state.favoritesOnly = false;
      state.search = "";
      state.indexedResults = null;
      if (searchInput) searchInput.value = "";
      document.querySelectorAll<HTMLElement>("[data-filter]").forEach((element) => {
        element.classList.toggle("chip--active", (element.dataset.value ?? "all") === "all");
      });
      syncFavBtn();
      syncCollectionPill();
      window.dispatchEvent(
        new CustomEvent("stealthis:collection-changed", { detail: { collection: "all" } })
      );
      applyFilters();
      syncUrl();
    });
  });

  // Collections mini-filter: narrows the (long) collection list client-side.
  const collectionFilterInput = document.getElementById("collection-filter-input") as HTMLInputElement | null;
  collectionFilterInput?.addEventListener("input", () => {
    const q = collectionFilterInput.value.trim().toLowerCase();
    document
      .querySelectorAll<HTMLElement>('#collection-list [data-filter="collection"]')
      .forEach((row) => {
        const label = row.dataset.label ?? "";
        const keep = !q || label === "all" || label.includes(q);
        row.style.display = keep ? "" : "none";
      });
  });

  // Search
  async function handleSearch(value: string) {
    state.search = value.toLowerCase().trim();
    state.indexedResults = null;
    syncUrl();
    if (!state.search) {
      applyFilters();
      return;
    }

    applyFilters();

    if (state.search.length < 2) return;

    const requestId = ++searchRequestId;
    if (searchTimer) window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(async () => {
      const activeSearch = state.search;
      const indexedResults = await runIndexedSearch(activeSearch);
      if (requestId !== searchRequestId || activeSearch !== state.search) return;

      state.indexedResults = indexedResults;
      applyFilters();
    }, 250);
  }

  searchInput?.addEventListener("input", () => {
    handleSearch(searchInput.value);
  });

  // Favorites toggle
  const favBtn = document.getElementById("favorites-filter-btn");
  function syncFavBtn() {
    if (!favBtn) return;
    favBtn.classList.toggle("chip--active", state.favoritesOnly);
    favBtn.classList.toggle("text-rose-400", state.favoritesOnly);
    const svg = favBtn.querySelector("svg");
    if (svg) svg.setAttribute("fill", state.favoritesOnly ? "currentColor" : "none");
  }
  favBtn?.addEventListener("click", () => {
    state.favoritesOnly = !state.favoritesOnly;
    syncFavBtn();
    applyFilters();
  });
  // Re-apply when a card's favorite status changes
  window.addEventListener("stealthis:favorites-changed", () => {
    if (state.favoritesOnly) applyFilters();
  });

  // Opt-in previews: toolbar toggle (library/index.astro) flips this on/off.
  window.addEventListener("stealthis:previews-toggle", (event) => {
    state.previewsEnabled = !!(event as CustomEvent).detail?.enabled;
    applyFilters();
  });

  // Sort toggle (grouped/latest) reparents cards — recompute the reveal window
  // in the new DOM order. Reset paging so the user starts at the top.
  window.addEventListener("stealthis:sort-changed", () => applyFilters());

  // Init count
  const params = new URLSearchParams(window.location.search);
  const collectionParam = params.get("collection");
  if (collectionParam) setFilter("collection", collectionParam, false);

  const categoryParam = params.get("category");
  if (categoryParam) setFilter("category", categoryParam, false);

  const difficultyParam = params.get("difficulty");
  if (difficultyParam) setFilter("difficulty", difficultyParam, false);

  const techParam = params.get("tech");
  if (techParam) setFilter("tech", techParam, false);

  const authorParam = params.get("author");
  if (authorParam) setFilter("author", authorParam, false);

  // Scroll to results on initial load if a specific filter is active from URL
  if ((categoryParam || collectionParam || difficultyParam || techParam || authorParam) && isMobileViewport()) {
    pendingScroll = true;
  }

  syncCollectionPill();

  const searchParam = params.get("search");
  if (searchParam && searchInput) {
    searchInput.value = searchParam;
    handleSearch(searchParam);
  } else {
    applyFilters();
  }
</script>

<style is:global>
