  }

  /* Floating progress pill — injected into <body> by the script above, so it must
     live in a global style block (scoped styles wouldn't reach it). */
  #preview-load-status {
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgb(203 213 225);
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid rgba(148, 163, 184, 0.28);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(8px);
  }

  #preview-load-status[hidden] {
    display: none;
  }

  .preview-load-spinner {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    border: 2px solid rgba(148, 163, 184, 0.3);
    border-top-color: rgb(125, 211, 252);
    animation: preview-load-spin 0.7s linear infinite;
  }

  @keyframes preview-load-spin {
