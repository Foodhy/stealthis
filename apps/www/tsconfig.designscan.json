{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@components/*": ["./src/components/*"],
      "@lib/*": ["./src/lib/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@stealthis/ai-providers": ["../../packages/ai-providers/src/index.ts"]
    }
  },
  "include": [
    "./src/components/DesignScan*.tsx",
    "./src/lib/design-scan/**/*.ts",
    "./src/lib/design-scan/env.d.ts"
  ],
  "exclude": ["./src/lib/design-scan/*.test.ts"]
}
