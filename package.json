{
  "name": "stealthis",
  "version": "0.6.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "sync:vendor": "bun scripts/sync-lab-vendor-modules.mjs",
    "sync:lab-vendor": "bun scripts/sync-lab-vendor-modules.mjs",
    "import:examples": "bun scripts/import-showcase-examples.mjs",
    "setup": "bun install",
    "dev:clean": "bun scripts/kill-dev-ports.mjs",
    "dev": "bun run dev:clean && (bun run dev:www & bun run dev:docs & bun run dev:lab & bun run dev:build & bun run dev:styleforge & bun run dev:dbviz & bun run dev:prompt-designer & bun run dev:mcp & bun run dev:remotion & bun run dev:vibe & bun run dev:arcade)",
    "dev:win": "bun run dev:clean && bun install && bun run --filter './apps/*' dev",
    "dev:www": "bun run --filter @stealthis/www dev",
    "dev:arcade": "bun run --filter @stealthis/arcade dev",
    "dev:docs": "bun run --filter @stealthis/docs dev",
    "dev:lab": "bun run --filter @stealthis/lab dev",
    "dev:build": "bun run --filter @stealthis/build dev",
    "dev:styleforge": "bun run --filter @stealthis/styleforge dev",
    "dev:dbviz": "bun run --filter @stealthis/dbviz dev",
    "dbviz:validate": "bun run --filter @stealthis/dbviz validate",
    "dbviz:supabase:check": "bun run --filter @stealthis/dbviz supabase:check",
    "dbviz:supabase:pull": "bun run --filter @stealthis/dbviz supabase:pull",
    "dbviz:supabase:draft": "bun run --filter @stealthis/dbviz supabase:draft",
    "dev:prompt-designer": "bun run --filter @stealthis/prompt-designer dev",
    "dev:mcp": "bun run --filter @stealthis/mcp dev",
    "dev:remotion": "bun run --filter @stealthis/remotion dev",
    "dev:vibe": "bun run --filter @stealthis/vibe dev",
    "build:www": "bun run --filter @stealthis/www build",
    "build:docs": "bun run --filter @stealthis/docs build",
    "build:lab": "bun run --filter @stealthis/lab build",
    "build:build": "bun run --filter @stealthis/build build",
    "build:styleforge": "bun run --filter @stealthis/styleforge build",
    "build:dbviz": "bun run --filter @stealthis/dbviz build",
    "build:prompt-designer": "bun run --filter @stealthis/prompt-designer build",
    "build:mcp": "bun run --filter @stealthis/mcp build",
    "build:remotion": "bun run --filter @stealthis/remotion build",
    "build:vibe": "bun run --filter @stealthis/vibe build",
    "build:arcade": "bun run --filter @stealthis/arcade build",
    "build": "bun install --frozen-lockfile && bun run build:www && bun run build:docs && bun run build:lab && bun run build:build && bun run build:dbviz && bun run build:prompt-designer && bun run build:mcp && bun run build:vibe && bun run build:arcade",
    "deploy:mcp": "bun run --filter @stealthis/mcp catalog && bun run --filter @stealthis/mcp build && bun run --filter @stealthis/mcp deploy",
    "deploy": "bun scripts/deploy.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "generate:challenges": "bun scripts/generate-challenges.ts",
    "publish:challenges": "bun scripts/publish-challenges.ts",
    "generate:lessons": "bun scripts/generate-lessons.ts",
    "audit": "bun audit",
    "outdated": "bun outdated --filter '*'",
    "security:trust": "bun pm untrusted",
    "security:verify": "bun scripts/security-verify.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "wrangler": "^4.112.0"
  }
}
